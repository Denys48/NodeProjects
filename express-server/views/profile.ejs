<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= name %></h1>
    <p>Роль: <%= role %></p>
    <p>Хобі:</p>
    <ul>
        <% hobbies.forEach(hobby => { %>
            <li><%= hobby %></li>
        <% }); %>
    </ul>
    <% if (isOnline === true) { %>
        <p>Онлайн</p>
    <% } else { %>
        <p>Офлайн</p>
    <% } %>
</body>
</html>