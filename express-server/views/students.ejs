<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Студенти</h1>
    <table>
        <thead>
            <tr>
                <th>Ім'я</th>
                <th>Рівень</th>
            </tr>
        </thead>
        <tbody>
            <% students.forEach(student => { %>
                <tr>
                    <td><%= student.name %></td>
                    <td><%= student.level %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>